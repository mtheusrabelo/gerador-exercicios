@startuml listar-categorias

actor "Usuário" as usuario
participant "Navegador" as navegador
participant "Provedor de categorias" as provedorCategorias
participant "Serviço de categorias" as servicoCategorias
participant "Armazenamento local" as armazenamentoLocal

alt "Listar Categorias" 
    usuario -> navegador: Visita /categories?pageSize=25&current=1
    group "Camada de domínio"
    navegador -> provedorCategorias: Obter lista de categorias
    provedorCategorias -> servicoCategorias: Obter categorias para página
    servicoCategorias -> armazenamentoLocal: Obter categorias para página
    armazenamentoLocal --> servicoCategorias: Retorna categorias
    servicoCategorias --> provedorCategorias: Retorna categorias
    provedorCategorias --> navegador: Retorna categorias
    end
    navegador --> usuario: Renderiza lista de categorias
end
@enduml

